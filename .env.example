# Variables de entorno del Back (T030). Este archivo lista los nombres y nunca lleva valores, ni
# siquiera los que no son secretos, porque los valores viven en Vercel y en el .env local (escenario
# «Las variables del Back están en Vercel y no en el repositorio» de US-17). La copia local se llama
# .env y no se versiona (scripts/preflight.sh, regla 3). En Vercel, Jefferson pega los valores de cada
# entorno, Production y Preview, por separado. Una copia tal cual no arranca la API, porque le faltan
# PERIODO_VIGENTE y CONJUNTO_REGLAS.

# Secreto. Cadena de conexión de PostgreSQL 18. En Vercel es la cadena con pooler (el agrupador de
# conexiones) de Neon con el usuario abet_app, y en la Mac apunta a una base local. Nunca se
# escribe aquí.
DATABASE_URL=

# Secreto. Clave aleatoria y larga con que la interfaz de programación de aplicaciones
# (application programming interface, API) protege la sesión de la cookie abet_sesion. Se genera
# aparte para cada entorno y nunca se escribe aquí.
SESION_SECRETO=

# Periodo de las cargas nuevas, según el requisito funcional (functional requirement, FR) FR-007
# de la spec 001, con la forma AAAA-C. No es un secreto. En el piloto vale 2026-2.
PERIODO_VIGENTE=

# Conjunto de reglas de las cargas nuevas (FR-007). No es un secreto. En el piloto vale
# R-2026-BORRADOR.
CONJUNTO_REGLAS=

# Guardia de datos inventados (FR-005). Con 1, la API responde 422 a todo export con un código de
# estudiante fuera de 99000000 a 99999999. Solo el valor 0 la apaga, así que sin valor queda
# encendida, y apagarla exige un cambio revisado en una solicitud de integración (pull request, PR).
# No es un secreto. En el piloto vale 1.
GUARDIA_DATOS_INVENTADOS=
