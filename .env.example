# Variables de entorno del Back (T030). Este archivo lista los nombres y nunca lleva secretos.
# La copia local se llama .env y no se versiona (scripts/preflight.sh, regla 3). En Vercel,
# Jefferson pega los valores de cada entorno, Production y Preview, por separado.

# Secreto. Cadena de conexión de PostgreSQL 16. En Vercel es la cadena con pooler (el agrupador de
# conexiones) de Neon con el usuario abet_app, y en la Mac apunta a una base local. Nunca se
# escribe aquí.
DATABASE_URL=

# Secreto. Clave aleatoria y larga con que la interfaz de programación de aplicaciones
# (application programming interface, API) protege la sesión de la cookie abet_sesion. Se genera
# aparte para cada entorno y nunca se escribe aquí.
SESION_SECRETO=

# Periodo de las cargas nuevas, según el requisito funcional (functional requirement, FR) FR-007
# de la spec 001. No es un secreto.
PERIODO_VIGENTE=2026-2

# Conjunto de reglas de las cargas nuevas (FR-007). No es un secreto.
CONJUNTO_REGLAS=R-2026-BORRADOR

# Guardia de datos inventados (FR-005). Con 1, la API responde 422 a todo export con un código de
# estudiante fuera de 99000000 a 99999999. Apagarla exige un cambio revisado en una solicitud de
# integración (pull request, PR). No es un secreto.
GUARDIA_DATOS_INVENTADOS=1
